# Copy to .env and fill in. Everything here is read in core/config.py and nowhere else.

ENVIRONMENT=local

# Every endpoint but /health requires this value in the X-API-Key header. Never empty; outside
# local it must be a random value of 32+ characters (`openssl rand -hex 32`) or nothing starts.
API_KEY=change-me

# The operator sign-in for /admin. Leave the password or the secret empty and /admin does not exist.
# The secret signs the session cookie: a long random value, e.g. `openssl rand -hex 32`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# Local: SQLite, nothing to install. Production: PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./local.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_helper

# Downloaded sources and rendered results; the database keeps only paths into it.
MEDIA_DIR=media

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_JOB_TIMEOUT_SECONDS=900
VIDEO_MAX_CONCURRENT_JOBS=2
VIDEO_MAX_DOWNLOAD_MEGABYTES=1024
